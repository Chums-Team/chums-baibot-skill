# x402 sidecar — env template. Copy to .env (gitignored) and fill.
# This file holds production secrets; never commit it.

# ===== docker compose =====
# Owner of ./data; the sidecar runs as this user inside the container.
# Leave the image's own user (1001) if ./data belongs to it.
UID=1001
GID=1001

# ===== Facilitator (x402 v2: /supported, /verify, /settle) =====
# Seller API key (X-API-KEY). Hosted BofAI: issued to the agent_wallet owner
# via their admin panel. Self-host: whatever key you seed in its config.
X402_FACILITATOR_API_KEY=
# Hosted BofAI v2 by default. Fallback: self-hosted TS facilitator on the
# shared docker network, e.g. http://x402-facilitator:8001
X402_FACILITATOR_URL=https://facilitator.bankofai.io

# ===== Scheme + network =====
# Only `exact` (Permit2 asset transfer) is implemented.
X402_SCHEME=exact
# Hex CAIP-2 ids: tron:0x2b6653dc (mainnet) | tron:0xcd8690dc (nile) | tron:0x94a9059e (shasta).
# Legacy tron:mainnet / tron:nile / tron:shasta are accepted and canonicalised.
X402_NETWORK=tron:0xcd8690dc
X402_TOKEN=USDT
# Permit deadline window in seconds (= paymentRequirements.maxTimeoutSeconds), 60..3595.
X402_MAX_TIMEOUT_SECONDS=600

# ===== Pay-to address =====
# TRON Base58 address that receives every top-up (the agent wallet).
X402_AGENT_WALLET=

# ===== Internal HMAC shared with the Rust bot =====
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# MUST match the bot's `x402.internal_secret` (config.yml) value.
X402_INTERNAL_SECRET=

# ===== HMAC for the (legacy) inbound settlement webhook =====
# The v2 facilitator does not push webhooks; the endpoint stays for a future
# reconciliation job. Still required so the endpoint never runs unsigned.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
X402_FACILITATOR_WEBHOOK_SECRET=

# ===== Where to POST settlement notifications =====
# Bot listens on its own internal HTTP. On the chums-shared Docker network
# the bot is `http://bot:9000/...`; for a native bot on Docker Desktop use
# `http://host.docker.internal:9000/...`.
BOT_X402_NOTIFY_URL=http://bot:9000/internal/x402-settled

# ===== Sidecar bind =====
SIDECAR_BIND_HOST=0.0.0.0
SIDECAR_BIND_PORT=8402

# ===== Local payment-id mapping DB =====
SIDECAR_DB_PATH=./data/sidecar.db

# ===== Stub vs. live facilitator =====
# false (default): /submit runs facilitator /verify + /settle for real.
# true: DEV ONLY. /payment-request emits a real-shaped envelope marked
# `_stub: true` and /submit acks without calling the facilitator; nothing
# is settled and the bot is never notified.
X402_FACILITATOR_USE_STUB=false

# ===== Facilitator readiness watch (background; off the payment path) =====
# Re-check /supported + relayer resources every N seconds (min 30).
X402_FACILITATOR_PROBE_INTERVAL_SEC=300
# Relayer must afford at least this many settles (energy or TRX to burn).
X402_FACILITATOR_MIN_SETTLES=5
# Consecutive failed /settle calls that mark the facilitator unavailable.
X402_FACILITATOR_FAILURE_THRESHOLD=3
# TronGrid-compatible RPC for relayer resource reads; per-network default when empty.
X402_TRON_RPC_URL=

# ===== Logging =====
LOG_LEVEL=INFO
