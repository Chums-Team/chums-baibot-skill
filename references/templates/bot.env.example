# Environment of the bot container. docker-compose.yml reads this file; copy it to
# `.env` (ignored by git) and fill in what you need.
#
# Every BAIBOT_* variable overrides a key of config.yml (the list is in
# src/entity/cfg/env.rs, the naming rule in docs/configuration/README.md). Keep the
# secrets here and everything else in config.yml, or put everything in config.yml
# and leave this file with UID/GID only; both work.
#
# Leave a variable commented out rather than empty: an empty value is an override
# too (it unsets the key of config.yml).

# ----- docker compose ---------------------------------------------------------
# Owner of ./data; the bot runs as this user inside the container.
UID=1000
GID=1000

# ----- Matrix account (docs/configuration/authentication.md) ------------------
# One of: a password, an access token, or a TRON wallet key (private key or seed phrase).
#BAIBOT_USER_PASSWORD=
#BAIBOT_USER_ACCESS_TOKEN=
#BAIBOT_USER_TRON_PRIVATE_KEY=
#BAIBOT_USER_TRON_SEED_PHRASE=
# Passphrase of the encryption recovery key.
#BAIBOT_USER_ENCRYPTION_RECOVERY_PASSPHRASE=

# ----- Persistence ------------------------------------------------------------
# Keys encrypting the session store and the configuration kept in account data.
# Generate each with: openssl rand -hex 32
#BAIBOT_PERSISTENCE_SESSION_ENCRYPTION_KEY=
#BAIBOT_PERSISTENCE_CONFIG_ENCRYPTION_KEY=

# ----- x402 top-ups (docs/configuration/x402.md) ------------------------------
# The same value as X402_INTERNAL_SECRET in x402-sidecar/.env.
# Generate with: openssl rand -hex 32
# Setting it (like any BAIBOT_X402_* variable) enables x402, which needs the
# `billing` section in config.yml. The sidecar's address and the bind settings for
# this compose layout are in the `x402` section of config.yml (see docker-compose.yml).
#BAIBOT_X402_INTERNAL_SECRET=
