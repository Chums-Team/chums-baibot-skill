# chums-baibot instance settings. Non-secret; created by `profile init`.
# The same file lives in the profile and, after deploy, in the instance
# directory on the host. Variables prefixed CHUMS_/BOT_/SIDECAR_ are read by
# the compose files of baibot (docs/runbook.md, "Several bots on one host").

# Name of the instance: its directory on the host and its compose project.
INSTANCE=__INSTANCE__
# Where the scripts run: `local`, or `user@host` over ssh.
TARGET=__TARGET__

# Source of the instance: the baibot repository and the ref to check out.
BAIBOT_GIT_URL=__GIT_URL__
BAIBOT_GIT_REF=__GIT_REF__

# Docker names, unique per instance on one host.
CHUMS_NETWORK=__INSTANCE__-net
BOT_IMAGE=__BOT_IMAGE__
BOT_CONTAINER_NAME=__INSTANCE__-bot
SIDECAR_IMAGE=__INSTANCE__-x402-sidecar:local
SIDECAR_CONTAINER_NAME=__INSTANCE__-x402-sidecar
# Loopback port of the sidecar's /health on the host. Unique per instance.
SIDECAR_HOST_PORT=__PORT__
